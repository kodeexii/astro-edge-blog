---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';

export const prerender = true;

// Logik Pratonton: Jika kita kat laman preview, tunjuk semua. 
// Jika kat website live, sembunyikan draf.
const isPreview = import.meta.env.PUBLIC_IS_PREVIEW === 'true';

const posts = await getCollection('blog', ({ data }) => {
	if (isPreview) return true; // Tunjuk semua kat preview site
	return data.status === 'published'; // Hanya tunjuk yang 'published' kat live site
});

// Susun ikut tarikh terbaru
posts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const months = ["Januari", "Februari", "Mac", "April", "Mei", "Jun", "Julai", "Ogos", "September", "Oktober", "November", "Disember"];
---

<Layout title="Blog | Astro-Edge" description="Baca artikel terbaru kami tentang teknologi dan perniagaan.">
	<section class="section">
		<div class="container">
			<header class="blog-header">
				<h1 class="blog-header__title">Artikel Terbaru</h1>
				<p class="blog-header__subtitle">Koleksi pemikiran, tutorial, dan kemas kini dari pasukan kami.</p>
			</header>

			<div class="blog-grid">
				{posts.map((post) => (
					<Card class="blog-post-card" padding={false}>
						<div class="blog-post-card__image-wrapper">
							{post.data.coverImage && (
								<img 
									src={post.data.coverImage.startsWith('public') ? post.data.coverImage.replace('public', '') : post.data.coverImage} 
									alt={post.data.title} 
									class="blog-post-card__img" 
								/>
							)}
						</div>
						<div class="p-6 flex flex-col gap-3">
							<time datetime={post.data.publishedAt.toISOString()} class="blog-date">
								{post.data.publishedAt.getUTCDate()} {months[post.data.publishedAt.getUTCMonth()]} {post.data.publishedAt.getUTCFullYear()}
							</time>
							
							<h2 class="blog-title">
								<a href={`/blog/${post.slug}`}>{post.data.title}</a>
							</h2>
							
							<p class="blog-desc">
								{post.data.description || (post.body ? post.body.substring(0, 120).replace(/[#*`]/g, '') + '...' : 'Tiada penerangan tersedia.')}
							</p>
							
							<div class="pt-2">
								<a href={`/blog/${post.slug}`} class="w-full">
									<Button variant="outline" class="w-full">
										Baca Lanjut
									</Button>
								</a>
							</div>
						</div>
					</Card>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	.blog-header {
		max-width: 600px;
		margin-bottom: 3rem;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 2.5rem;
	}

	.blog-post-card__image-wrapper {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background-color: var(--color-border);
	}

	.blog-post-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s ease;
	}

	.blog-post-card:hover .blog-post-card__img {
		transform: scale(1.05);
	}

	.blog-date {
		font-size: var(--fs-xs);
		color: var(--color-text-light);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.blog-title {
		font-size: var(--fs-l);
		line-height: 1.3;
		margin: 0;
		
		& a {
			text-decoration: none;
			color: var(--color-text);
			transition: color 0.2s;
			&:hover { color: var(--color-primary); }
		}
	}

	.blog-desc {
		font-size: var(--fs-m);
		color: var(--color-text-light);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		line-height: 1.6;
	}

	/* Utility classes */
	.p-6 { padding: 1.5rem; }
	.flex { display: flex; }
	.flex-col { flex-direction: column; }
	.gap-3 { gap: 0.75rem; }
	.pt-2 { padding-top: 0.5rem; }
	.w-full { width: 100%; }
</style>
