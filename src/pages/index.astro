---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Astro-Edge | Blog & E-commerce">
	<section class="section">
		<div class="container">
			<div class="hero">
				<h1 class="hero__title">Masa Depan Web Adalah <span class="text-gradient">Laju & Edge-Ready</span></h1>
				<p class="hero__subtitle">Dibina menggunakan Astro 5, Cloudflare D1, dan Keystatic untuk pengalaman pembangunan dan pengguna yang luar biasa.</p>
				<div class="hero__actions">
					<a href="/products" class="button button--primary">Lihat Produk</a>
					<a href="/blog" class="button button--outline">Baca Blog</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section" style="background: #f1f5f9;">
		<div class="container">
			<h2>Kenapa Astro-Edge?</h2>
			<div class="features-grid">
				<div class="feature-card">
					<h3>Zero-JS by Default</h3>
					<p>Hanya hantar JavaScript yang anda perlukan. Pantas untuk SEO dan pengguna.</p>
				</div>
				<div class="feature-card">
					<h3>Edge Native</h3>
					<p>Deploy terus ke Cloudflare Edge network untuk latency terendah.</p>
				</div>
				<div class="feature-card">
					<h3>Keystatic CMS</h3>
					<p>Pengurusan kandungan berasaskan Git yang selesa dan selamat.</p>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		max-width: 800px;
		margin-inline: auto;
	}

	.hero__title {
		margin-bottom: 1rem;
	}

	.text-gradient {
		background: linear-gradient(to right, var(--color-primary), #ec4899);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero__subtitle {
		font-size: var(--fs-l);
		color: var(--color-text-light);
		margin-bottom: 2rem;
	}

	.hero__actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}

	.feature-card {
		padding: 2rem;
		background: white;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
	}
</style>
