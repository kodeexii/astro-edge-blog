---
import { makePage } from '@keystatic/astro/ui';
import config from '../../../../keystatic.config';

export const prerender = false; // Wajib false untuk Admin UI
const KeystaticPage = makePage(config);
---

<KeystaticPage />

<style is:global>
  /* Guna CSS untuk tukar label butang secara instant */
  
  /* 1. Tukar 'Create Pull Request' -> 'TERBITKAN' */
  button:has(span:contains("Create Pull Request")),
  button span:contains("Create Pull Request") {
    visibility: hidden;
    position: relative;
  }

  /* Nota: CSS :contains() tidak disokong secara meluas, 
     kita akan gunakan JavaScript di bawah untuk lebih stabil. */
</style>

<script is:inline>
  /**
   * PENTERJEMAH KEYSTATIC (Editor-Friendly)
   * Skrip ni akan pantau skrin dan tukar perkataan teknikal kepada bahasa editor.
   */
  const translateUI = () => {
    const replacements = {
      'Create Pull Request': '🌟 TERBITKAN KE WEBSITE',
      'Pull Request': '🌟 TERBITKAN',
      'Create branch': '📝 BUAT DRAF BARU',
      'Current branch': '📂 Lokasi Draf',
      'Save': '💾 SIMPAN DRAF',
      'Changes saved': '✅ Berjaya Disimpan!',
      'Create': '➕ TAMBAH BARU'
    };

    // Cari semua elemen span dan button
    const elements = document.querySelectorAll('span, button, h2, label');
    
    elements.forEach(el => {
      const text = el.innerText.trim();
      if (replacements[text]) {
        el.innerText = replacements[text];
      }
    });
  };

  // Pantau perubahan dalam halaman (MutationObserver)
  const observer = new MutationObserver(translateUI);
  observer.observe(document.body, { childList: true, subtree: true });

  // Jalankan kali pertama
  translateUI();
</script>
