---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';

const products = await getCollection('products');
---

<Layout title="Katalog Produk | Astro-Edge" description="Dapatkan produk digital dan fizikal berkualiti tinggi kami.">
	<section class="section">
		<div class="container">
			<header class="products-header">
				<h1 class="products-header__title">Katalog Produk</h1>
				<p class="products-header__subtitle">Pilih daripada koleksi produk terpilih kami.</p>
			</header>

			<div class="products-grid">
				{products.map((product) => (
					<Card class="product-item" padding={false}>
						<div class="product-item__image-wrapper">
							{product.data.image ? (
								<img src={product.data.image} alt={product.data.name} class="product-item__img" />
							) : (
								<div class="product-item__placeholder">📦</div>
							)}
						</div>
						
						<div class="p-5 flex flex-col flex-1">
							<h2 class="product-item__name">{product.data.name}</h2>
							<p class="product-item__price">RM {product.data.price.toFixed(2)}</p>
							
							<p class="product-item__desc">{product.data.description}</p>
							
							<div class="mt-auto pt-4 flex flex-col gap-3">
								<div class="flex justify-between items-center">
									<span class:list={['stock-tag', product.data.stock > 0 ? 'stock-tag--in' : 'stock-tag--out']}>
										{product.data.stock > 0 ? `Stok: ${product.data.stock}` : 'Habis Stok'}
									</span>
								</div>
								<Button 
									variant="primary" 
									class="w-full" 
									disabled={product.data.stock <= 0}
									onclick={`window.location.href='/products/${product.id}'`}
								>
									Lihat Detail
								</Button>
							</div>
						</div>
					</Card>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	.products-header {
		margin-bottom: 4rem;
		max-width: 600px;
	}

	.products-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 2.5rem;
	}

	.product-item__image-wrapper {
		width: 100%;
		aspect-ratio: 3 / 4; /* Portrait ratio macam ekau nak */
		overflow: hidden;
		background-color: #f8fafc;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.product-item__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.product-item:hover .product-item__img {
		transform: scale(1.08);
	}

	.product-item__placeholder {
		font-size: 4rem;
		opacity: 0.2;
	}

	.product-item__name {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-text);
		margin-bottom: 0.25rem;
	}

	.product-item__price {
		font-size: 1.25rem;
		font-weight: 800;
		color: var(--color-primary);
		margin-bottom: 0.75rem;
	}

	.product-item__desc {
		font-size: var(--fs-s);
		color: var(--color-text-light);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.stock-tag {
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
		text-transform: uppercase;
		
		&--in { background: #f0fdf4; color: #16a34a; }
		&--out { background: #fef2f2; color: #dc2626; }
	}

	/* Utilities */
	.p-5 { padding: 1.25rem; }
	.flex { display: flex; }
	.flex-col { flex-direction: column; }
	.justify-between { justify-content: space-between; }
	.items-center { align-items: center; }
	.gap-3 { gap: 0.75rem; }
	.mt-auto { margin-top: auto; }
	.pt-4 { padding-top: 1rem; }
	.w-full { width: 100%; }
</style>
