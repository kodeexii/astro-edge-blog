---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const products = await getCollection('products');
---

<Layout title="Katalog Produk | Astro-Edge" description="Dapatkan produk digital dan fizikal berkualiti tinggi kami.">
	<section class="section">
		<div class="container">
			<header class="products-header">
				<h1 class="products-header__title">Katalog Produk</h1>
				<p class="products-header__subtitle">Pilih daripada koleksi produk terpilih kami.</p>
			</header>

			<div class="products-grid">
				{products.map((product) => (
					<div class="product-card">
						<div class="product-card__image-placeholder">
							{product.data.image ? (
								<img src={product.data.image} alt={product.data.name} />
							) : (
								<div class="placeholder-icon">📦</div>
							)}
						</div>
						<div class="product-card__content">
							<h2 class="product-card__title">{product.data.name}</h2>
							<p class="product-card__price">RM {product.data.price.toFixed(2)}</p>
							<p class="product-card__description">{product.data.description}</p>
							<div class="product-card__footer">
								<span class="product-card__stock">Stok: {product.data.stock}</span>
								<a href={`/products/${product.id}`} class="button button--primary button--full-width">Beli Sekarang</a>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	.products-header {
		margin-bottom: 3rem;
		max-width: 600px;
	}

	.products-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 2rem;
	}

	.product-card {
		background: white;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.product-card__image-placeholder {
		aspect-ratio: 1 / 1;
		background: #f1f5f9;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 4rem;
	}

	.product-card__content {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
	}

	.product-card__title {
		font-size: var(--fs-l);
	}

	.product-card__price {
		font-weight: 800;
		color: var(--color-primary);
		font-size: var(--fs-l);
	}

	.product-card__description {
		font-size: var(--fs-s);
		color: var(--color-text-light);
		margin-bottom: 1rem;
	}

	.product-card__footer {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.product-card__stock {
		font-size: var(--fs-xs);
		color: var(--color-text-light);
		text-align: right;
	}
</style>
