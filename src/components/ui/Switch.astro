---
interface Props {
  id: string;
  label: string;
  checked?: boolean;
  class?: string;
  [key: string]: any;
}

const { id, label, checked = false, class: className, ...rest } = Astro.props;
---

<div class:list={['c-switch-group', className]}>
  <input 
    type="checkbox" 
    id={id} 
    role="switch" 
    class="c-switch" 
    checked={checked} 
    aria-checked={checked}
    {...rest}
  />
  <label for={id} class="c-switch-label">{label}</label>
</div>

<style>
  .c-switch-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .c-switch {
    appearance: none;
    width: 2.5rem;
    height: 1.25rem;
    background: var(--color-border, #e2e8f0);
    border-radius: 1rem;
    position: relative;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;

    &::before {
      content: "";
      position: absolute;
      width: 1rem;
      height: 1rem;
      background: #ffffff;
      border-radius: 50%;
      top: 0.125rem;
      left: 0.125rem;
      transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    &:checked {
      background: var(--color-text, #0f172a);
      &::before {
        transform: translateX(1.25rem);
      }
    }

    &:focus-visible {
      outline: 2px solid var(--color-primary, #3b82f6);
      outline-offset: 2px;
    }

    &:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  }

  .c-switch-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text, #1e293b);
    cursor: pointer;
  }
</style>

<script>
  // Kemaskini aria-checked secara dinamik
  document.querySelectorAll('.c-switch').forEach(toggle => {
    toggle.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      target.setAttribute('aria-checked', target.checked.toString());
    });
  });
</script>
