---
interface Props {
  class?: string;
  width?: string;
  height?: string;
  circle?: boolean;
}

const { 
  class: className, 
  width = '100%', 
  height = '1rem', 
  circle = false 
} = Astro.props;

const style = {
  width,
  height,
  borderRadius: circle ? '50%' : '0.25rem'
};
---

<div 
  class:list={['c-skeleton', className]} 
  style={style}
  aria-hidden="true"
></div>

<style>
  .c-skeleton {
    background-color: var(--color-border, #f1f5f9);
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    display: inline-block;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
</style>
