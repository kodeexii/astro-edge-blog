---
interface Props {
  label: string;
  id: string;
  name: string;
  type?: 'text' | 'email' | 'password' | 'number' | 'url';
  placeholder?: string;
  required?: boolean;
  hint?: string;
  error?: string;
  value?: string;
}

const { 
  label, id, name, type = 'text', placeholder, required, hint, error, value 
} = Astro.props;
---

<div class="c-field-group">
  <label class="c-field-group__label" for={id}>
    {label} {required && <span class="c-field-group__required" aria-hidden="true">*</span>}
  </label>
  
  <input 
    class="c-input"
    type={type}
    id={id}
    name={name}
    placeholder={placeholder}
    required={required}
    aria-required={required}
    aria-describedby={hint ? `${id}-hint` : undefined}
    value={value}
    {...Astro.props}
  />
  
  {hint && <span class="c-field-group__hint" id={`${id}-hint`}>{hint}</span>}
  {error && <span class="c-field-group__error" id={`${id}-error`} role="alert">{error}</span>}
</div>

<style>
  .c-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;

    .c-field-group__label {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-text, #1e293b);
    }

    .c-field-group__required {
      color: #ef4444;
      margin-left: 0.125rem;
    }

    .c-field-group__hint {
      font-size: 0.75rem;
      color: var(--color-text-light, #64748b);
    }

    .c-field-group__error {
      font-size: 0.75rem;
      color: #ef4444;
      font-weight: 500;
    }
  }

  .c-input {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border, #cbd5e1);
    border-radius: 0.375rem;
    font-size: 0.875rem;
    transition: all 0.2s;
    background: #ffffff;
    font-family: inherit;

    &:focus {
      outline: none;
      border-color: var(--color-primary, #0f172a);
      box-shadow: 0 0 0 2px rgba(15, 23, 42, 0.1);
    }

    &::placeholder {
      color: #94a3b8;
    }

    &[aria-invalid="true"] {
      border-color: #ef4444;
    }
  }
</style>
